<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Lumina_AI</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ModelContextProtocol" Version="2.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- CharacterIdentityService.cs 已移入项目目录，SDK 风格自动编译，无需显式引用 -->

	<!-- 包含 llama 目录下的所有文件（包括子目录），并复制到输出目录（仅当文件更新时） -->
	<ItemGroup>
		<Content Include="llama\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="mcp\WindowsMcp.exe" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="mcp\WindowsMcp.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>